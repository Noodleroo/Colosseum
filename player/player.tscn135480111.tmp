script/source = "# res://scenes/ui/pinned_hotbar_ui.gd
class_name PinnedHotbarUI
extends Control

@export var slot_ui_scene: PackedScene

@onready var hotbar_grid: Container = $VBoxContainer/HotbarGrid
@onready var selected_item_label: Label = $VBoxContainer/SelectedItemLabel

var bound_inventory: InventoryData
var active_pin_index: int = 0


func bind_inventory(inventory_data: InventoryData) -> void:
	if bound_inventory and bound_inventory.inventory_updated.is_connected(refresh_hotbar_wrapper):
		bound_inventory.inventory_updated.disconnect(refresh_hotbar_wrapper)

	bound_inventory = inventory_data
	
	if bound_inventory:
		bound_inventory.inventory_updated.connect(refresh_hotbar_wrapper)

	# If the node isn't inside the tree yet (ready hasn't fired), wait for ready
	if not is_inside_tree():
		await ready

	_rebuild_hotbar_structure()

func refresh_hotbar_wrapper(_inventory_data: InventoryData = null) -> void:
	_update_hotbar_contents()


func set_active_slot(pin_index: int) -> void:
	active_pin_index = pin_index
	_update_hotbar_contents()


# 1. Instantiates child nodes ONLY ONCE when binding or when pin count changes
func _rebuild_hotbar_structure() -> void:
	if hotbar_grid == null or slot_ui_scene == null or bound_inventory == null:
		return

	# Clear out all previous nodes immediately
	for child in hotbar_grid.get_children():
		child.free()

	# Create exactly one slot node per pinned index
	for pin_i in range(bound_inventory.pinned_indices.size()):
		var slot_node = slot_ui_scene.instantiate() as InventorySlotUI
		hotbar_grid.add_child(slot_node)

	_update_hotbar_contents()


# 2. Updates icons, text, and selection borders on existing nodes (NEVER creates new nodes)
func _update_hotbar_contents() -> void:
	if bound_inventory == null or hotbar_grid == null:
		return

	var children = hotbar_grid.get_children()
	var total_pins = bound_inventory.pinned_indices.size()

	# If the number of pinned slots changed (e.g. pinned/unpinned an item), rebuild structure
	if children.size() != total_pins:
		_rebuild_hotbar_structure()
		return

	for pin_i in range(total_pins):
		var slot_node = children[pin_i] as InventorySlotUI
		if slot_node:
			var actual_slot_index = bound_inventory.pinned_indices[pin_i]
			var is_selected = (pin_i == active_pin_index)
			var slot_data = null

			if actual_slot_index >= 0 and actual_slot_index < bound_inventory.slot_datas.size():
				slot_data = bound_inventory.slot_datas[actual_slot_index]

			slot_node.update_slot(slot_data, actual_slot_index, true, is_selected)

	_update_selected_label()


func _update_selected_label() -> void:
	if selected_item_label == null or bound_inventory == null:
		return

	if active_pin_index >= 0 and active_pin_index < bound_inventory.pinned_indices.size():
		var actual_slot_index = bound_inventory.pinned_indices[active_pin_index]
		if actual_slot_index >= 0 and actual_slot_index < bound_inventory.slot_datas.size():
			var slot_data = bound_inventory.slot_datas[actual_slot_index]
			if slot_data and slot_data.item:
				selected_item_label.text = slot_data.item.get_localized_name()
				return

	selected_item_label.text = \"\"
"

[sub_resource type="GDScript" id="GDScript_qjkh3"]
script/source = "# res://scenes/ui/inventory_slot_ui.gd
class_name InventorySlotUI
extends PanelContainer

signal slot_dropped(origin_index: int, target_index: int)
signal slot_pin_requested(index: int)

@onready var icon: TextureRect = $Icon
@onready var quantity_label: Label = $QuantityLabel
@onready var pin_indicator: Control = get_node_or_null(\"PinIndicator\")
@onready var selection_border: Control = get_node_or_null(\"SelectionBorder\")
@onready var drop_preview_border: Control = get_node_or_null(\"DropPreviewBorder\")

var slot_index: int = -1
var slot_data: SlotData


func _ready() -> void:
	# Hide drop border at start
	if drop_preview_border:
		drop_preview_border.visible = false

	# Connect mouse exit to clear highlight
	mouse_exited.connect(_on_mouse_exited)


func update_slot(data: SlotData, index: int, is_pinned: bool = false, is_selected: bool = false) -> void:
	slot_index = index
	slot_data = data

	if pin_indicator:
		pin_indicator.visible = is_pinned

	if selection_border:
		selection_border.visible = is_selected

	if slot_data and slot_data.item:
		icon.texture = slot_data.item.icon
		icon.visible = true

		# Build multi-line tooltip string with Name and Description
		var item_name = slot_data.item.get_localized_name()
		var item_desc = slot_data.item.get_localized_description()

		if item_desc.is_empty():
			tooltip_text = item_name
		else:
			tooltip_text = \"%s\\n%s\" % [item_name, item_desc]

		if slot_data.quantity > 1:
			quantity_label.text = str(slot_data.quantity)
			quantity_label.visible = true
		else:
			quantity_label.visible = false
	else:
		icon.texture = null
		icon.visible = false
		quantity_label.visible = false
		tooltip_text = \"\"


func _on_mouse_exited() -> void:
	if drop_preview_border:
		drop_preview_border.visible = false


# 1. Initiates the drag when left-clicking and dragging a filled slot
func _get_drag_data(_at_position: Vector2) -> Variant:
	if slot_data == null or slot_data.item == null:
		return null

	# Create a dedicated TextureRect for the drag preview
	var drag_preview = TextureRect.new()
	drag_preview.texture = slot_data.item.icon

	# Prevent texture warping & maintain aspect ratio
	drag_preview.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	drag_preview.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	drag_preview.custom_minimum_size = Vector2(40, 40)
	drag_preview.modulate = Color(1, 1, 1, 0.8)

	# Wrap in a Control container so it centers on the mouse cursor
	var preview_control = Control.new()
	preview_control.add_child(drag_preview)
	drag_preview.position = -drag_preview.custom_minimum_size / 2.0

	set_drag_preview(preview_control)

	return {
		\"origin_index\": slot_index,
		\"slot_data\": slot_data
	}


# 2. Checks if a dragged item can be dropped here and highlights the target slot
func _can_drop_data(_at_position: Vector2, data: Variant) -> bool:
	var is_valid = typeof(data) == TYPE_DICTIONARY and data.has(\"origin_index\")

	# Only highlight this specific slot if the drag payload is valid
	if drop_preview_border:
		drop_preview_border.visible = is_valid

	return is_valid

func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_RIGHT:
			slot_pin_requested.emit(slot_index)
			accept_event() # Prevents parent containers from swallowing the right-click

# 3. Executes the item swap when releasing the mouse button
func _drop_data(_at_position: Vector2, data: Variant) -> void:
	if drop_preview_border:
		drop_preview_border.visible = false

	if typeof(data) == TYPE_DICTIONARY and data.has(\"origin_index\"):
		slot_dropped.emit(data[\"origin_index\"], slot_index)


# 4. Hide drop indicator preview if mouse leaves the slot boundary
func _notification(what: int) -> void:
	if what == NOTIFICATION_DRAG_END:
		if drop_preview_border:
			drop_preview_border.visible = false
"

